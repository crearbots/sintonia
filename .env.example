# Copiar a .env y ajustar solo en local (no subir .env a Git).
# La app carga este archivo al arrancar (python-dotenv).

APP_USER=comunicaciones
APP_PASSWORD=cambiar-en-local
SECRET_KEY=dev-local-key-cambiar-por-valor-largo-aleatorio

# Opcional: ruta del SQLite (por defecto infomira_censo.db en la raíz del proyecto)
# DATABASE_PATH=infomira_censo.db